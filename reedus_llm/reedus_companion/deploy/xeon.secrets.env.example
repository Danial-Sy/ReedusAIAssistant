# copy to deploy/xeon.secrets.env (gitignored) and fill in.
# gemini: https://aistudio.google.com/apikey, then enable billing on the project. on the free
# tier google may train on your input, and reedus sends history, bulletins and camera descriptions.
export GEMINI_API_KEY=""

# inworld: platform.inworld.ai -> Runtime -> API Keys. a base64 string.
export INWORLD_API_KEY=""

# optional, local mode only. empty = searxng then DDG
export BRAVE_API_KEY="${BRAVE_API_KEY:-}"
