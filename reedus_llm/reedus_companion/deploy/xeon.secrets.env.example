# copy to deploy/xeon.secrets.env (gitignored) and fill in.
# gemini: https://aistudio.google.com/apikey, then enable billing on the project. on the free
# tier google may train on your input, and reedus sends history, bulletins and camera descriptions.
export GEMINI_API_KEY=""

# other cloud brains. all optional: the easy way is ReedOS → Settings → Cloud brain, which has
# step-by-step key instructions and stores keys in memory/llm.json (gitignored). anything set
# in the app wins over these.
export ANTHROPIC_API_KEY="${ANTHROPIC_API_KEY:-}"     # console.anthropic.com, prepaid credits
export OPENAI_API_KEY="${OPENAI_API_KEY:-}"           # platform.openai.com, prepaid credits
export OPENROUTER_API_KEY="${OPENROUTER_API_KEY:-}"   # openrouter.ai, one key for many models
# also read: XAI_API_KEY DEEPSEEK_API_KEY GROQ_API_KEY MISTRAL_API_KEY REEDUS_LLM_CUSTOM_KEY

# inworld: platform.inworld.ai -> Runtime -> API Keys. a base64 string.
export INWORLD_API_KEY=""

# optional, local mode only. empty = searxng then DDG
export BRAVE_API_KEY="${BRAVE_API_KEY:-}"

# Reedus Lite (lite/hub.py): the device must send this in its hello. same value as LITE_TOKEN
# in ReedusLite/firmware/src/secrets.h. empty = any device on the LAN can connect and hear
# the Lite's mic stream, so set one.
export REEDUS_LITE_TOKEN="${REEDUS_LITE_TOKEN:-}"
