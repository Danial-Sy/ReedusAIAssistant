# source on the xeon before running reedus. every tunable is ${VAR:-default} so anything
# exported before sourcing wins. CUDA_VISIBLE_DEVICES is the one exception, the GT 710 is
# never a compute target.
#   source /mnt/nvme/reedus/reedus_llm/reedus_companion/deploy/xeon.env
# devices: mic = EMEET SmartCam C950, speaker = UACDemoV1.0 (Jieli), camera = /dev/video0

# --- paths (nvme) ---
export REEDUS_ROOT="${REEDUS_ROOT:-/mnt/nvme/reedus}"
export REEDUS_KNOWLEDGE_DIR="${REEDUS_KNOWLEDGE_DIR:-$REEDUS_ROOT/knowledge}"
export REEDUS_VISION_PATH="${REEDUS_VISION_PATH:-$REEDUS_ROOT/reedus_oj}"
export PYTHONPATH="${REEDUS_ROOT}/reedus_llm${PYTHONPATH:+:$PYTHONPATH}"

# --- audio / camera (name substrings, not portaudio indices) ---
# output prefers pulse/pipewire when several devices match; exclusive ALSA hw: on the
# UACDemo caused Device unavailable (-9985) on the listen jingle
export REEDUS_MIC_DEVICE="${REEDUS_MIC_DEVICE:-EMEET SmartCam C950: USB Audio}"
export REEDUS_TTS_DEVICE="${REEDUS_TTS_DEVICE:-UACDemoV1.0: USB Audio}"
export REEDUS_CAM="${REEDUS_CAM:-0}"
export REEDUS_VISION="${REEDUS_VISION:-1}"

# --- STT, cpu only ---
# `base` is ~2x faster than `small` here with acceptable accuracy; go small if names get mangled
export REEDUS_STT_DEVICE="${REEDUS_STT_DEVICE:-cpu}"
export REEDUS_STT_COMPUTE="${REEDUS_STT_COMPUTE:-int8}"
export REEDUS_STT_MODEL="${REEDUS_STT_MODEL:-base}"
# end of utterance: patient enough that soft mid-sentence dips don't cut you off
export REEDUS_MIC_SILENCE_SEC="${REEDUS_MIC_SILENCE_SEC:-1.4}"
export REEDUS_MIC_MAX_SEC="${REEDUS_MIC_MAX_SEC:-45}"
export REEDUS_MIC_HANGOVER="${REEDUS_MIC_HANGOVER:-0.28}"

# --- barge-in ---
# speak-barge threshold adapts to speaker->mic bleed
export REEDUS_BARGE="${REEDUS_BARGE:-1}"
export REEDUS_THINK_BARGE="${REEDUS_THINK_BARGE:-1}"
export REEDUS_BARGE_RMS_MIN="${REEDUS_BARGE_RMS_MIN:-0.038}"
export REEDUS_BARGE_BLEED_MULT="${REEDUS_BARGE_BLEED_MULT:-1.55}"
export REEDUS_BARGE_HOLD_MS="${REEDUS_BARGE_HOLD_MS:-160}"
export REEDUS_BARGE_IGNORE_MS="${REEDUS_BARGE_IGNORE_MS:-450}"
# pre-roll kept before a speak-barge trigger. it's all his own voice bleeding in, 2s of it
# got whisper transcribing HIM. keep just enough not to clip your first word.
export REEDUS_BARGE_PREROLL="${REEDUS_BARGE_PREROLL:-0.15}"
# think-barge floor. 0.038 measured to trigger on this mic; REEDUS_DEBUG=1 prints
# "peak rms X vs thresh Y" every uninterrupted turn, tune from that
export REEDUS_THINK_BARGE_RMS="${REEDUS_THINK_BARGE_RMS:-0.035}"
export REEDUS_THINK_BARGE_AMBIENT_MULT="${REEDUS_THINK_BARGE_AMBIENT_MULT:-2.2}"
export REEDUS_THINK_BARGE_DELAY="${REEDUS_THINK_BARGE_DELAY:-0.8}"
# an interruption is usually a replacement ("actually just tell me the weather"), so the
# cut keeps recording and that becomes the next turn. CAPTURE=0 for stop-only.
export REEDUS_THINK_BARGE_CAPTURE="${REEDUS_THINK_BARGE_CAPTURE:-1}"
export REEDUS_THINK_BARGE_PREROLL="${REEDUS_THINK_BARGE_PREROLL:-0.7}"
export REEDUS_THINK_BARGE_SILENCE_SEC="${REEDUS_THINK_BARGE_SILENCE_SEC:-1.0}"
export REEDUS_THINK_BARGE_MAX_SEC="${REEDUS_THINK_BARGE_MAX_SEC:-12}"

# --- wake word (openWakeWord, ~5% of one core) ---
# replaces the energy gate for idle wake and both barge paths. there's no pretrained model
# for the name, train one with deploy/train_wakeword.sh ("hey reedus", not "reedus": two
# syllables is thin evidence and whisper already hears "breeders"/"readers"). with no model
# this is silently inactive and everything falls back to the energy path.
export REEDUS_WAKEWORD="${REEDUS_WAKEWORD:-1}"
export REEDUS_WAKEWORD_MODEL="${REEDUS_WAKEWORD_MODEL:-$REEDUS_ROOT/wakeword/hey_reedus.onnx}"
# tune from `setup_wakeword.sh listen`. raise toward 0.7 if the TV sets it off
export REEDUS_WAKEWORD_THRESHOLD="${REEDUS_WAKEWORD_THRESHOLD:-0.5}"
# silero VAD gate, off by default: it gates every prediction and on this mic it was
# suppressing real detections. set to 0.3 if music starts triggering him.
export REEDUS_WAKEWORD_VAD="${REEDUS_WAKEWORD_VAD-}"
# set to a directory to record what each barge watcher heard, as wav
export REEDUS_BARGE_DUMP="${REEDUS_BARGE_DUMP:-}"
export REEDUS_WAKEWORD_REFRACTORY="${REEDUS_WAKEWORD_REFRACTORY:-1.5}"
# interrupting mid-speech is much harder acoustically (your voice reaches the mic mixed
# with his), so the bar is lower for that phase. a false trigger there is nearly free.
# safe in a way energy never was: the model still has to match the phrase.
export REEDUS_WAKEWORD_THRESHOLD_SPEAK="${REEDUS_WAKEWORD_THRESHOLD_SPEAK:-0.25}"
# =0 restores the energy gate, which can't tell you from the TV
export REEDUS_BARGE_WAKEWORD="${REEDUS_BARGE_WAKEWORD:-1}"

# --- weather (open-meteo, no key) ---
export REEDUS_CITY="${REEDUS_CITY:-Woodbridge, Virginia}"
# export REEDUS_LAT=38.6582
# export REEDUS_LON=-77.2497
export REEDUS_WEATHER="${REEDUS_WEATHER:-1}"

# page fetch after a snippet miss was a major latency sink
export REEDUS_PAGE_FETCH="${REEDUS_PAGE_FETCH:-0}"
# aux calls held on the main model, see config.ROUTER_KEEP_ON_MAIN for why each one
export REEDUS_ROUTER_KEEP_ON_MAIN="${REEDUS_ROUTER_KEEP_ON_MAIN:-topic-brief,subjects,correction,look-router}"

# --- search: local searxng (optional, big snippet-quality win) ---
# one engine gives one snippet per page and it's a lottery. searxng merges several.
#   bash $REEDUS_ROOT/reedus_llm/reedus_companion/deploy/run_searxng.sh
# probed on demand, nothing listening = silent DDG fallback
export REEDUS_SEARXNG_URL="${REEDUS_SEARXNG_URL:-http://127.0.0.1:8888}"
# re-probe interval so a container started after the voice loop gets picked up. 0 = once.
export REEDUS_SEARXNG_RECHECK_S="${REEDUS_SEARXNG_RECHECK_S:-180}"

# --- llama.cpp ---
export CUDA_VISIBLE_DEVICES=""
export OPENBLAS_NUM_THREADS=1
# thread budget, computed not hardcoded. measured with deploy/bench_threads.sh:
#   threads  decode  prefill
#   6        7.85    39.5
#   10       7.76    54.4
#   14       7.69    67.6
#   16       7.62    66.4   (SMT sibling, no gain)
# decode is memory-bound and flat, prefill is compute-bound and stops at physical cores.
# 7.8 tok/s is this machine's ceiling regardless, which is the whole reason cloud mode exists.
# NOT a bare `nproc`: gnu nproc honours OMP_NUM_THREADS as a lower bound and we export it
# below, so re-sourcing this file would ratchet the count down every time.
_REEDUS_CPUS="$(OMP_NUM_THREADS= OMP_THREAD_LIMIT= nproc)"
# physical cores MINUS 2: at -t 14 the mic thread was left on an SMT sibling and
# "mic blocks DROPPED (CPU starved)" kept firing. a dropped block costs a whole utterance
# and the bench says decode only loses ~1% between 12 and 14.
_REEDUS_PHYS="$(lscpu 2>/dev/null | awk -F: '/^Core\(s\) per socket/{gsub(/ /,"",$2);c=$2} /^Socket\(s\)/{gsub(/ /,"",$2);s=$2} END{if(c&&s) print c*s}')"
[ -z "$_REEDUS_PHYS" ] && _REEDUS_PHYS=$(( _REEDUS_CPUS / 2 ))
_REEDUS_MAIN=$(( _REEDUS_PHYS - 2 )); [ "$_REEDUS_MAIN" -lt 2 ] && _REEDUS_MAIN=2
[ "$_REEDUS_MAIN" -gt "$_REEDUS_CPUS" ] && _REEDUS_MAIN="$_REEDUS_CPUS"
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-$_REEDUS_MAIN}"
export REEDUS_THREADS="${REEDUS_THREADS:-$_REEDUS_MAIN}"
export REEDUS_ROUTER_THREADS="${REEDUS_ROUTER_THREADS:-2}"
# 1024 was too small once warm() primes ~8 shapes, persona got evicted. 1536 fits with whisper+kokoro.
export REEDUS_PROMPT_CACHE_MB="${REEDUS_PROMPT_CACHE_MB:-1536}"
export REEDUS_ROUTER_PROMPT_CACHE_MB="${REEDUS_ROUTER_PROMPT_CACHE_MB:-512}"
export REEDUS_N_CTX="${REEDUS_N_CTX:-3072}"
export REEDUS_ROUTER_MODEL="${REEDUS_ROUTER_MODEL:-$REEDUS_ROOT/gguf/qwen3-1.7b-Q4_K_M.gguf}"

# main persona gguf. the 3B (Qwen2.5-3B-Instruct, qwen3 has no 3B) won the A/B against the
# 4B on speed with the persona holding up, so it's the default. for the 4B:
#   export REEDUS_MAIN_GGUF=$REEDUS_ROOT/gguf/base-qwen3-4b-Q4_K_M.gguf
export REEDUS_MAIN_GGUF="${REEDUS_MAIN_GGUF:-$REEDUS_ROOT/gguf/Qwen2.5-3B-Instruct-Q4_K_M.gguf}"

# speculative decoding is off for in-process llama-cpp-python (see config). the native
# server uses REEDUS_LLAMA_SPEC instead.
export REEDUS_SPECULATIVE="${REEDUS_SPECULATIVE:-0}"
export REEDUS_SPEC_TOKENS="${REEDUS_SPEC_TOKENS:-2}"

# --- native llama-server (the production path) ---
# build once: deploy/build_llama_cpp.sh, start: deploy/run_llama_servers.sh.
# REEDUS_BACKEND=gguf is the in-process legacy path.
export REEDUS_BACKEND="${REEDUS_BACKEND:-server}"
export REEDUS_MAIN_URL="${REEDUS_MAIN_URL:-http://127.0.0.1:8080}"
export REEDUS_ROUTER_URL="${REEDUS_ROUTER_URL:-http://127.0.0.1:8081}"
# ngram-simple (free) | draft (needs REEDUS_DRAFT_GGUF, same family) | off
export REEDUS_LLAMA_SPEC="${REEDUS_LLAMA_SPEC:-ngram-simple}"
# export REEDUS_DRAFT_GGUF=$REEDUS_ROOT/gguf/qwen3-1.7b-Q4_K_M.gguf
# export REEDUS_LLAMA_SPEC=draft
export REEDUS_LLAMA_BIN="${REEDUS_LLAMA_BIN:-$REEDUS_ROOT/bin}"

# vision assets on nvme so the first look doesn't download YOLO/CLIP into cwd
export REEDUS_VISION_HOME="${REEDUS_VISION_HOME:-$REEDUS_ROOT/vision_models}"
export YOLO_CONFIG_DIR="${YOLO_CONFIG_DIR:-$REEDUS_VISION_HOME}"
export ULTRALYTICS_HOME="${ULTRALYTICS_HOME:-$REEDUS_VISION_HOME}"
if [ -f "$REEDUS_VISION_HOME/yolov8s-worldv2.pt" ]; then
  export REEDUS_BASE_WEIGHTS="$REEDUS_VISION_HOME/yolov8s-worldv2.pt"
fi

# never synth while the model generates (3.5s text turns became 11-17s voiced)
export REEDUS_TTS_OVERLAP="${REEDUS_TTS_OVERLAP:-0}"
export REEDUS_TTS_THREADS="${REEDUS_TTS_THREADS:-2}"

# wake-word UI tones, 0 to silence
export REEDUS_JINGLE="${REEDUS_JINGLE:-1}"

# openblas from conda, if present
if [ -n "${CONDA_PREFIX:-}" ]; then
  export LD_LIBRARY_PATH="${CONDA_PREFIX}/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi
# miniconda on nvme (setup_xeon.sh)
if [ -z "${CONDA_PREFIX:-}" ] && [ -f /mnt/nvme/reedus/miniconda3/etc/profile.d/conda.sh ]; then
  # shellcheck disable=SC1091
  source /mnt/nvme/reedus/miniconda3/etc/profile.d/conda.sh
  conda activate reedus-serve 2>/dev/null || true
  if [ -n "${CONDA_PREFIX:-}" ]; then
    export LD_LIBRARY_PATH="${CONDA_PREFIX}/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
  fi
fi

# peak-normalize, a loudness request never a clip. 4.0 hard-clipped on the UACDemo DAC.
export REEDUS_TTS_GAIN="${REEDUS_TTS_GAIN:-2.5}"
export REEDUS_DEBUG="${REEDUS_DEBUG:-1}"
export REEDUS_PROFILE="${REEDUS_PROFILE:-1}"

# --- cloud mode ---
# swaps the brain for gemini 3.7 flash and the voice for inworld TTS-2; STT, vision, memory
# and the persona are shared. first run: pip install -r requirements/cloud.txt, then
# python -m reedus_companion.cloud.selftest.
# keys live in deploy/xeon.secrets.env (gitignored), this file is tracked:
#     cp deploy/xeon.secrets.env.example deploy/xeon.secrets.env
_REEDUS_SECRETS="$(dirname "${BASH_SOURCE[0]:-$0}")/xeon.secrets.env"
if [ -f "$_REEDUS_SECRETS" ]; then
    . "$_REEDUS_SECRETS"
else
    echo "[reedus] no deploy/xeon.secrets.env -- cloud mode will stay local." >&2
fi

# unset = ask out loud at startup, silence defaults to local
# export REEDUS_MODE=cloud

# --- brain ---
export REEDUS_GEMINI_MODEL="${REEDUS_GEMINI_MODEL:-gemini-3.7-flash}"
# thinking tokens bill at the output rate and buy nothing for conversation. 3.7-flash
# accepts low|medium|high only, "minimal" is a hard 400.
export REEDUS_GEMINI_THINK="${REEDUS_GEMINI_THINK:-low}"
export REEDUS_GEMINI_THINK_ROUTER="${REEDUS_GEMINI_THINK_ROUTER:-low}"
export REEDUS_GEMINI_INPUT_STYLE="${REEDUS_GEMINI_INPUT_STYLE:-structured}"
# search in cloud mode goes through gemini grounding, not searxng. 0 sends it back.
export REEDUS_CLOUD_SEARCH="${REEDUS_CLOUD_SEARCH:-1}"
# DON'T pin REEDUS_GEMINI_INLINE_SEARCH here. unset, the code ties it to REEDUS_LOCAL_SEARCH
# so exactly one system owns search. pinned to 0 in cloud mode, nothing searches at all.
# export REEDUS_GEMINI_INLINE_SEARCH=1
export REEDUS_GEMINI_TIMEOUT="${REEDUS_GEMINI_TIMEOUT:-45}"
export REEDUS_GEMINI_RETRIES="${REEDUS_GEMINI_RETRIES:-2}"
# export REEDUS_GEMINI_INPUT_STYLE=structured

# --- voice ---
export REEDUS_INWORLD_MODEL="${REEDUS_INWORLD_MODEL:-inworld-tts-2}"
# TTS-2 not TTS-2 flash: natural-language steering is TTS-2 only and steering is the whole
# reason to move off kokoro. the style text should describe reedus, not a generic voice.
export REEDUS_INWORLD_STYLE="${REEDUS_INWORLD_STYLE:-British, precise and slightly prim, dry wit under it; a close friend who is quietly amused by you; unhurried, real pauses, never announcer-like or brash}"
export REEDUS_INWORLD_DELIVERY="${REEDUS_INWORLD_DELIVERY:-BALANCED}"
export REEDUS_INWORLD_RATE="${REEDUS_INWORLD_RATE:-1.0}"
export REEDUS_INWORLD_VOICE=Clive

# --- accent (both modes) ---
# default american, en-GB restores the british kokoro blend
# export REEDUS_LOCALE=en-US
# export REEDUS_VOICE="am_michael:0.6,am_adam:0.4"

# --- spend ---
# monthly ceiling in USD; when it trips he says so and drops to local. ~$20/month at
# 100 turns/day. 0 = no cap. python -m reedus_companion.cloud.budget for month-to-date.
export REEDUS_CLOUD_BUDGET="${REEDUS_CLOUD_BUDGET:-35.00}"
export REEDUS_CLOUD_LEDGER="${REEDUS_CLOUD_LEDGER:-$REEDUS_ROOT/cloud_ledger.json}"
# the inworld free tier is a one-time allotment, tracked across months. 0 once on a paid plan.
export REEDUS_INWORLD_FREE_MINUTES="${REEDUS_INWORLD_FREE_MINUTES:-40}"

# --- which python runs reedus ---
# systemd doesn't inherit conda activation, so this has to be explicit
export REEDUS_CONDA_BASE="${REEDUS_CONDA_BASE:-$REEDUS_ROOT/miniconda3}"
export REEDUS_CONDA_ENV="${REEDUS_CONDA_ENV:-reedus-serve}"
# export REEDUS_PYTHON=/mnt/nvme/reedus/miniconda3/envs/reedus-serve/bin/python

# gemini latency A/B is done: 3.7-flash/low vs 3.6-flash/minimal, ~1.4s time-to-first-text
# either way (that's the api floor, not thinking) and 3.6's grounded search came back empty.
# stay on 3.7-flash / low, ~2s a turn.

# in cloud mode the corpus is off (mode.knowledge_enabled): it exists to compensate for a 3B
# not knowing things, and with gemini it only added latency and bad matches. REEDUS_KNOWLEDGE=1 forces it.
# the LLM subject-extraction call is off in both modes, see knowledge/retrieve.py. REEDUS_LLM_SUBJECT=1.
