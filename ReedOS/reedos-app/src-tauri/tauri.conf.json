{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReedOS",
  "version": "0.2.0",
  "identifier": "com.reedus.reedos",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ReedOS",
        "width": 1280,
        "height": 800,
        "maximized": true,
        "fullscreen": false,
        "resizable": true,
        "backgroundColor": "#0E1812"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
